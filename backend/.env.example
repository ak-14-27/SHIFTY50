# Database connection URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shifty50_db?schema=public"

# If you want to use SQLite for rapid zero-dependency local testing without installing PostgreSQL:
# 1. Change provider in schema.prisma to "sqlite"
# 2. Set DATABASE_URL="file:./dev.db"

# Server Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET="shifty50_super_secure_jwt_secret_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# CORS configuration
CORS_ORIGIN="http://localhost:5173"
